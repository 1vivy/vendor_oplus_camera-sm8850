<?xml version="1.0" encoding="iso-8859-1"?>
<!--
  Maps the OEM (Oplus/OnePlus) app signing certs to seinfo=oplus_app so that the
  camera app (com.oplus.camera) and its extension helpers resolve to the
  opluscamera_app SELinux domain via seapp_contexts (this dir).

  These are the two certs that stock OOS 16.0.7.201 maps to seinfo=oplus_app in
  /system_ext/etc/selinux/system_ext_mac_permissions.xml (CN=AndroidTeam,
  O=Oplus, OU=OSTeam). The camera APK shipped by this port must be signed with
  one of these certs for the seinfo to apply on a running device.

  This file is merged automatically by the Android build because
  SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS includes vendor/oneplus/camera/sepolicy/private
  (see sepolicy/SEPolicy.mk).
-->
<policy>
    <!-- Oplus OSTeam signing cert (serial f2eefcd200c718b9); stock seinfo=oplus_app -->
    <signer signature="">
        <seinfo value="oplus_app"/>
    </signer>
    <!-- Oplus OSTeam signing cert (serial 9ae9bea546da6233); stock seinfo=oplus_app -->
    <signer signature="">
        <seinfo value="oplus_app"/>
    </signer>
</policy>
