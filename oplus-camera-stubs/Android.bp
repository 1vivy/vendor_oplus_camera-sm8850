// OPlus camera framework wrapper stubs. Installed to /system_ext/framework as a
// runtime shared library (declared <library> + <uses-library> in OplusCamera), NOT a
// boot jar. com.oplus.wrapper.* etc. resolve via the app's classloader, off boot.art.
java_library {
    name: "oplus-camera-stubs",
    srcs: ["src/**/*.java"],
    libs: ["oplus-fwk"],
    platform_apis: true,
    installable: true,
    system_ext_specific: true,
}
